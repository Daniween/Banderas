rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validPseudo(data) {
      return !data.keys().hasAny(['pseudo'])
        || (data.pseudo is string && data.pseudo.size() > 0 && data.pseudo.size() <= 20);
    }

    // Un score doit être cohérent : on ne peut pas publier 500/197 ou un temps négatif
    function validScore(data) {
      return data.keys().hasOnly(['userId', 'pseudo', 'mode', 'region', 'score', 'total', 'timeSeconds', 'formattedTime', 'timestamp'])
        && data.userId == request.auth.uid
        && validPseudo(data)
        && data.mode in ['survival', 'capital', 'map', 'custom']
        && data.region is string
        && data.score is int && data.total is int
        && data.score >= 0 && data.total > 0 && data.score <= data.total && data.total <= 197
        && data.timeSeconds is int && data.timeSeconds >= 0
        && data.timestamp == request.time;
    }

    // Profils utilisateurs : chacun ne lit et n'écrit que le sien
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validPseudo(request.resource.data);
    }

    // Scores : lecture publique (classement), création validée, jamais modifiés
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if signedIn() && validScore(request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == resource.data.userId;
    }
  }
}
